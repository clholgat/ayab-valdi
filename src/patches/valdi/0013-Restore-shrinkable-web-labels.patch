Restore the previous Web label sizing contract. PR #148 creates labels through
createBaseLayoutItemElement(), whose flexShrink: 0 default makes multiline text
retain its intrinsic width inside horizontal rows. Long status and help labels
then widen the page instead of wrapping. The previous label element used the
browser's shrinkable flex-item default; opt labels back into flex-shrink so
numberOfLines=0 content remains contained on narrow screens.

diff --git a/src/valdi_modules/src/valdi/web_renderer/src/elements/LabelElementClass.ts b/src/valdi_modules/src/valdi/web_renderer/src/elements/LabelElementClass.ts
--- a/src/valdi_modules/src/valdi/web_renderer/src/elements/LabelElementClass.ts
+++ b/src/valdi_modules/src/valdi/web_renderer/src/elements/LabelElementClass.ts
@@ -223,6 +223,7 @@ export class LabelElementClass extends ElementClass {
   protected onCreateElement(): HTMLElement {
     const element = createBaseLayoutItemElement('span');
     assignStyles(element, {
+      flexShrink: 1,
       display: 'inline',
       whiteSpace: 'pre-wrap',
       wordWrap: 'break-word',
