Restore the multiline text-view interaction contract from the previous Web
renderer. TextViewElementClass currently creates a pointer-inactive div with
contentEditable=false, so text views with onChange render like editors but
cannot receive focus or keyboard input unless an explicit enabled attribute is
sent. Text views are editable by default; enabled=false can still opt out.
diff --git a/src/valdi_modules/src/valdi/web_renderer/src/elements/TextViewElementClass.ts b/src/valdi_modules/src/valdi/web_renderer/src/elements/TextViewElementClass.ts
--- a/src/valdi_modules/src/valdi/web_renderer/src/elements/TextViewElementClass.ts
+++ b/src/valdi_modules/src/valdi/web_renderer/src/elements/TextViewElementClass.ts
@@ -674,13 +674,16 @@ export class TextViewElementClass extends ElementClass<TextViewElement> {
     assignStyles(element, {
       fontFamily: SYSTEM_FONT_FAMILY,
       outline: 'none',
       overflow: 'hidden',
+      pointerEvents: 'auto',
       whiteSpace: 'pre-wrap',
       wordBreak: 'normal',
       wordWrap: 'break-word',
     });
     element.tabIndex = -1;
-    element.contentEditable = 'false';
+    element.setAttribute('role', 'textbox');
+    element.setAttribute('aria-multiline', 'true');
+    element.contentEditable = 'plaintext-only';
     element.value = '';
     element.selectionStart = 0;
     element.selectionEnd = 0;
