Normalize external-repository fallback paths before copying web dependency
outputs. Bazel exposes those short paths as ../valdi~/..., which otherwise
escapes the declared tree artifact and makes valdi_web_application builds fail.
--- a/bzl/valdi/valdi_collapse_web_paths.bzl
+++ b/bzl/valdi/valdi_collapse_web_paths.bzl
@@ -18,7 +18,17 @@ def _dest_native(rel):
             tail = "/".join(parts[i + 1:])
             base = (parent + "/web") if parent else "web"
             return base + ("/" + tail if tail else "")
-    return "/".join(parts)
+
+    # External repositories have short paths such as
+    # ../valdi~/src/valdi_modules/src/valdi/coreutils/src/RuntimeBase.d.ts.
+    # Keep the module-relative portion and never allow the fallback path to
+    # escape the declared output tree.
+    valdi_marker = "/src/valdi_modules/src/valdi/"
+    if valdi_marker in rel:
+        return rel.split(valdi_marker, 1)[1]
+    if rel.startswith("../"):
+        rel = rel[3:]
+    return rel

 # Dest path substrings that should not be registered (test files, etc).
 # Shared by collapse_web_paths and generate_register_native_modules so native layout stays in sync.
